REPORT ZCONTROL_BS2 NO STANDARD PAGE HEADING.

TABLES: KNA1, VBAK.

TYPES: BEGIN OF TY_STR,
        KUNNR TYPE KUNNR,
        VBELN TYPE VBELN_VA,
        ERDAT TYPE ERDAT,
        NETWR TYPE NETWR_AK,
      END OF TY_STR.

DATA: IT TYPE TABLE OF TY_STR,
      WA TYPE          TY_STR.


SELECT KNA1~KUNNR
       VBAK~VBELN
       VBAK~ERDAT VBAK~NETWR

  INTO TABLE IT UP TO 20 ROWS
  FROM KNA1 INNER JOIN VBAK
  ON KNA1~KUNNR = VBAK~KUNNR.


LOOP AT IT INTO WA.
  AT FIRST.
    WRITE:/55  'KNA1 AND VBAK TABLE RECORD' COLOR 3.
ULINE.
  WRITE:/ 'KUNNR' COLOR 4,
        40 'VBELN' COLOR 3,
        60 'ERDAT' COLOR 7,
        80 'NETWR' COLOR 6.
  ENDAT.
  AT NEW KUNNR.
    WRITE:/ 'THE KUNNR IS:',WA-KUNNR.
  ENDAT.

    WRITE:/40 WA-VBELN,
          60 WA-ERDAT,
          80 WA-NETWR.

AT END OF KUNNR.
   SUM.
   WRITE:/ 'THE SUBTOTAL:' ,WA-NETWR.
ENDAT.
ULINE.
AT LAST.
   SUM.
   WRITE:/ 'THE GRAND TOTAL:' ,WA-NETWR.
ENDAT.

ENDLOOP.
