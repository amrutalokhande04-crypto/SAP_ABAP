* INNER JOIN USING ZSTUDENT AND ZCOURSE TABLES 

REPORT ZSTUINER.

TABLES: ZSTUDENTT,ZCOURSEE.

SELECTION-SCREEN:BEGIN OF BLOCK B2 WITH FRAME TITLE TEXT-000.
  SELECT-OPTIONS: STUID FOR ZSTUDENTT-STUD_ID OBLIGATORY.
SELECTION-SCREEN:END OF BLOCK B2.

TYPES: BEGIN OF TY_STR,
        STUD_ID   TYPE ZSTID,
        STUD_NAME TYPE ZSN,
        CITY      TYPE ZSN,
        COURSE    TYPE ZCR,
        FEES      TYPE ZFE,
       END OF TY_STR.

DATA: IT TYPE TABLE OF TY_STR,
      WA TYPE TY_STR.

SELECT ZSTUDENTT~STUD_ID
       ZSTUDENTT~STUD_NAME
       ZSTUDENTT~CITY
       ZCOURSEE~COURSE
       ZCOURSEE~FEES
INTO TABLE IT
FROM ZSTUDENTT INNER JOIN ZCOURSEE
ON ZSTUDENTT~STUD_ID = ZCOURSEE~STUD_ID
WHERE ZSTUDENTT~STUD_ID IN STUID.

ULINE.
WRITE:/ 'STUD_ID' COLOR 3,
      10 'STUD_NAME'COLOR 4 ,
      20 'CITY' COLOR 5,
      30 'COURSE' COLOR 6,
      40 'FEES' COLOR 1.
ULINE.

LOOP AT IT INTO WA.
WRITE:/ WA-STUD_ID,
       10 WA-STUD_NAME,
       20 WA-CITY,
       30 WA-COURSE,
       40 WA-FEES.
ENDLOOP.
