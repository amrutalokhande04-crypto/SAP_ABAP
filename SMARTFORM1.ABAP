REPORT ZSMARTFORM_A3.

TABLES: ZCUST, BNKA, ZEMP_A1.

SELECTION-SCREEN:BEGIN OF BLOCK B2 WITH FRAME TITLE TEXT-000.
  PARAMETERS:N_CUSTID TYPE ZCUST-CUST_ID,
             S_BANKA TYPE BNKA-BANKA.
SELECTION-SCREEN:END OF BLOCK B2.

DATA: BEGIN OF WA1,
       CUST_ID TYPE ZCUID,
       MOBILE_NO TYPE ZMOBILE,
       EMAIL TYPE ZEMAIL,
      END OF WA1,

      BEGIN OF WA2,
        BANKS TYPE BANKS,
        BANKA TYPE BANKA,
        ORT01 TYPE ORT01_GP,
      END OF WA2.


DATA: FUN3 TYPE RS38L_FNAM,

      IT TYPE TABLE OF ZEMP_STR3,
      WA TYPE          ZEMP_STR3.


SELECT SINGLE CUST_ID MOBILE_NO EMAIL
  FROM ZCUST INTO WA1
  WHERE CUST_ID = N_CUSTID.

SELECT SINGLE BANKS BANKA ORT01
  FROM BNKA INTO WA2
  WHERE BANKA = S_BANKA.

SELECT EMPID EMPNAME EMPGEN EMPPOST SALLARY
  FROM ZEMP_A1 INTO  CORRESPONDING FIELDS OF TABLE IT.
  SORT IT BY EMPID.


CALL FUNCTION 'SSF_FUNCTION_MODULE_NAME'
  EXPORTING
    FORMNAME                 ='ZFORM_A3'

 IMPORTING
   FM_NAME                  = FUN3.


CALL FUNCTION FUN3
  EXPORTING

    CUST_ID                    = WA1-CUST_ID
    MOBILE_NO                  = WA1-MOBILE_NO
    EMAIL                      = WA1-EMAIL
    BANKS                      = WA2-BANKS
    BANKA                      = WA2-BANKA
    ORT01                      = WA2-ORT01
  TABLES
    IT                         = IT.
